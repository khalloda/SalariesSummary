// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Employee {
  id          String   @id @default(cuid())
  name        String
  normalizedName String @unique
  category    String?  // Partners/شركاء, Lawyers/محامين, Admins/عاملين, Consultants/مستشارين
  employeeCode String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // SEPEmployees.xlsx fields - Basic Info
  nameArabic  String?  // الاسم بالعربية
  jobTitle    String?  // Job Title
  department  String?  // Department
  
  // Dates
  dateOfBirth DateTime? // Date of Birth
  joiningDate DateTime? // Joining Date
  
  // Education
  graduationCertificate String? // Graduation - Certificate (Ph.D., Masters, Bachelor, etc.)
  graduationSection    String? // Graduation - Section (International Business Law, Private Law, etc.)
  graduationUniversity  String? // Graduation - University / School
  graduationYear        Int?    // Graduation - Year
  
  // Identification Numbers
  socialInsurance       String? // Social Insurance Number
  barAssociation        String? // Bar Association Number
  barAssociationValidTill DateTime? // Bar Association Valid Till
  barAssociationDegree  String? // درجة القيد (Bar Association Degree)
  taxCard               String? // Tax Card Number
  nationalId            String? // National ID Number (from NationalID column)
  nationalIdValidTill   DateTime? // National ID Valid Till date
  
  // Contact Information
  address               String? // Address Details
  addressRegion         String? // Region / City
  addressGovernorate    String? // Governorate
  extension             String? // Extension
  mobileNumber          String? // Mobile Number
  
  // Employment Details
  contractType          String? // Contract Type
  contractDuration      String? // Contract Duration
  contractRenewalDate   DateTime? // Date of Renewal
  status                String? // Status (Active, Resigned)
  
  // Experience
  experienceInYears     Int?    // Experience In - Years
  experienceInMonths    Int?    // Experience In - Months
  experienceOutYears    Int?    // Experience Out - Years
  experienceOutMonths   Int?    // Experience Out - Months
  
  // Additional metadata (stored as JSON for flexibility)
  additionalData        String? // JSON string for any other fields
  
  // Personnel data (stored as JSON)
  personnelData         String? // JSON: { criminalRecord, militaryCertificate, idCopy, educationCertificate, birthCertificate, recommendationLetter, personalPhotos, taxCard, associationId, form6, laptopPcTablet, workStub, insuranceStartDate }
  
  // Resignation data
  resignationDate       DateTime? // Date of resignation
  resignationReason     String? // Reason for resignation
  
  salaries    SalaryRecord[]
  annualBonuses AnnualBonus[]
  contractRecords ContractRecord[]
  personnelRecord PersonnelRecord?
  resignationRecords ResignationRecord[]
  
  @@index([normalizedName])
  @@index([category])
  @@index([department])
  @@index([status])
  @@index([employeeCode])
}

model ResignationRecord {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  // Resignation details
  resignationDate DateTime
  jobTitle        String?  // Job title at time of resignation
  department      String?  // Department at time of resignation
  category        String?  // Category at time of resignation
  reason          String?  // Reason for resignation (if available)
  
  // Metadata
  importedFrom    String?  // Source file/sheet
  importedAt      DateTime @default(now())
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([employeeId])
  @@index([resignationDate])
}

model SalaryRecord {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  year              Int
  month             Int // 1-12
  monthName         String // "January", "يونيو", etc.
  
  // Basic salary
  basicSalary       Float    @default(0)
  
  // Additions - Direct (affect salary)
  directAdditions   Float    @default(0)
  
  // Additions - Indirect (affect gross only)
  indirectAdditions Float    @default(0)
  
  // Yearly increase and bonuses
  yearlyIncrease    Float    @default(0)
  bonuses           Float    @default(0)
  
  // Deductions - From salary
  salaryDeductions  Float    @default(0)
  
  // Deductions - From gross only
  grossDeductions   Float    @default(0)
  
  // Calculated totals
  gross             Float    @default(0)
  net               Float    @default(0)
  
  // Breakdown (stored as JSON string for flexibility)
  additionsBreakdown String?   // JSON: { category: amount }
  deductionsBreakdown String?  // JSON: { category: amount }
  
  // Metadata
  paymentMethod     String?
  accountNumber     String?
  notes             String?
  category          String?  // Category from the sheet (Partners/شركاء, Lawyers/محامين, Admins/عاملين, Consultants/مستشارين)
  
  // Source file info
  sourceFile        String
  importedAt        DateTime @default(now())
  
  @@index([employeeId])
  @@index([year, month])
  @@unique([employeeId, year, month])
}

model ImportLog {
  id          String   @id @default(cuid())
  fileName    String
  year        Int
  month       Int
  status      String   // "success", "error", "partial"
  recordsImported Int  @default(0)
  errors      String?  // JSON string
  importedAt  DateTime @default(now())
  
  @@index([year, month])
}

model AnnualBonus {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  year              Int      // 2023, 2024, etc.
  
  // Base salary reference - unified annual increase data (year-agnostic)
  previousYearNet    Float    @default(0) // Net salary for previous year (e.g., 2024 if year=2025)
  previousYearGross  Float    @default(0) // Gross salary for previous year
  currentYearNet     Float    @default(0) // Net salary for current year (e.g., 2025 if year=2025)
  currentYearGross   Float    @default(0) // Gross salary for current year
  annualIncreaseNet  Float    @default(0) // Annual increase amount (Net) - currentYearNet - previousYearNet
  annualIncreaseGross Float   @default(0) // Annual increase amount (Gross) - currentYearGross - previousYearGross
  
  // Legacy fields (kept for backward compatibility)
  netSalary          Float    @default(0) // Net salary for the year (use currentYearNet)
  grossSalary        Float    @default(0) // Gross salary for the year (use currentYearGross)
  
  // Bonus amounts
  bonusAmount       Float    @default(0)  // Total bonus for the year
  bonusFirstHalf    Float?   // Bonus for first half (if split)
  bonusSecondHalf   Float?   // Bonus for second half (if split)
  previousYearBonus Float?   // Bonus from previous year (for comparison)
  
  // Calculated metrics
  reflectedInMonths Float?   // Bonus as multiple of monthly salary
  reflectedInPercent Float?  // Bonus as percentage of annual salary
  remainingFromPrevious Float? // Difference from previous year (bonusFirstHalf - previousYearBonus)
  yearComparison    Float?   // Total change from previous year ((bonusFirstHalf + bonusSecondHalf) - previousYearBonus)
  
  // Metadata
  notes             String?
  sourceFile        String?
  importedAt        DateTime @default(now())
  
  @@unique([employeeId, year])
  @@index([year])
  @@index([employeeId])
  @@index([year, employeeId])
}

model ContractRecord {
  id                String   @id @default(cuid())
  employeeId        String?
  employee          Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  // Contract details
  employeeName      String?  // Employee name (for matching)
  employeeCode      String?  // Employee code (for matching)
  contractDate      DateTime? // Contract/renewal date
  contractDuration  String?  // Contract Duration (e.g., "Renewal for One Year")
  comments          String?  // Comments/notes
  
  // Metadata
  sourceFile        String?  // Source file name
  importedAt        DateTime @default(now())
  
  @@index([employeeId])
  @@index([employeeName])
  @@index([employeeCode])
  @@index([contractDate])
}

model PersonnelRecord {
  id                    String    @id @default(cuid())
  employeeId            String   @unique
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  // Document Status Fields
  criminalRecord        String?  // 'Present', 'Missing'
  militaryCertificate   String?  // 'Copy', 'Original', 'N/A', 'Missing'
  idCopy                Boolean? @default(true)
  educationCertificate  String?  // 'Copy', 'Original', 'Missing'
  birthCertificate      String?  // 'Copy', 'Original', 'Missing'
  recommendationLetter  Boolean? // true = Present, false = Missing
  personalPhotos        Boolean? // true = Present, false = Missing
  taxCard               Boolean? // true = Present, false = Missing
  associationId         Boolean? // true = Present, false = Missing
  form6                 String?  @default("N/A") // 'N/A', 'Present', 'Missing'
  
  // Asset Fields
  laptopPcTablet        String?  // JSON array: ['Laptop', 'PC', 'Tablet'] or single value for backward compatibility
  
  // Other Fields
  workStub              String?  @default("N/A") // 'N/A', 'Present', 'Missing'
  insuranceStartDate    DateTime?
  
  // Metadata
  importedAt            DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  sourceFile            String?
  
  @@index([criminalRecord])
  @@index([militaryCertificate])
  @@index([laptopPcTablet])
  @@index([insuranceStartDate])
}

